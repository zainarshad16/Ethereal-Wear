generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  resetToken    String?
  resetTokenExpiry DateTime?
  role          String    @default("USER") // USER or ADMIN
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String
  price         Float
  imageUrl      String
  hoverImageUrl String?
  category      String
  stock         Int      @default(0)
  sizeStock     Json?    // e.g. {"XS": 5, "S": 10, "M": 15, "L": 10, "XL": 5}
  images        String[] @default([])
  sku           String?
  isFeatured    Boolean  @default(false)
  isOnSale      Boolean  @default(false)
  salePercentage Int?
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        OrderItem[]
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model StoreSettings {
  id               String   @id @default("global")
  topBannerText    String   @default("FREE SHIPPING ON ALL ORDERS OVER $100")
  heroHeading      String   @default("The Summer Edit")
  heroSubheading   String   @default("Lightweight linens and effortless silhouettes.")
  heroButtonText   String   @default("DISCOVER NOW")
  heroButtonLink   String   @default("/shop")
  heroImage        String   @default("https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070&auto=format&fit=crop")
  
  // JSON arrays of items
  categories       String? // JSON string
  highlights       String? // JSON string
  reviews          String? // JSON string
  
  updatedAt        DateTime @updatedAt
}
